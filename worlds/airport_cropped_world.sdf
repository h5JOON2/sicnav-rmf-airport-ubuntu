		<plugin filename="libcrowd_simulator.so" name="crowd_simulation">
			<behavior_file>behavior_file.xml</behavior_file>
			<scene_file>scene_file.xml</scene_file>
			<update_time_step>0.1</update_time_step>
			<model_type>
