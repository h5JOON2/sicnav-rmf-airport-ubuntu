<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="airport_cropped">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Global Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Airport Concourse Floor (Ground Plane) -->
    <model name="airport_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.80 1</ambient>
            <diffuse>0.82 0.82 0.84 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cropped Airport Terminal Walls Model -->
    <include>
      <uri>model://airport_cropped</uri>
      <name>airport_cropped</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Waiting Area Chairs -->
    <include>
      <uri>model://PotatoChipChair</uri>
      <name>chair_potato_1</name>
      <pose>6.0 -5.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://PotatoChipChair</uri>
      <name>chair_potato_2</name>
      <pose>7.5 -5.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://WhiteChipChair</uri>
      <name>chair_white_1</name>
      <pose>6.0 -8.0 0 0 0 3.14159</pose>
    </include>
    <include>
      <uri>model://WhiteChipChair</uri>
      <name>chair_white_2</name>
      <pose>7.5 -8.0 0 0 0 3.14159</pose>
    </include>

    <!-- Pedestrians for Social Navigation Validation -->
    <include>
      <uri>model://Standing person</uri>
      <name>pedestrian_standing_1</name>
      <pose>3.5 4.0 0 0 0 -1.57</pose>
    </include>

    <include>
      <uri>model://Standing person</uri>
      <name>pedestrian_standing_2</name>
      <pose>-5.0 6.0 0 0 0 0.8</pose>
    </include>

    <include>
      <uri>model://MaleVisitorPhone</uri>
      <name>pedestrian_phone_1</name>
      <pose>-3.0 -4.0 0 0 0 1.57</pose>
    </include>

  </world>
</sdf>

